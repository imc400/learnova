# ============================================================================
# Learnova — Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# Para verificar SOLO que compila sin keys:  SKIP_ENV_VALIDATION=1 pnpm build
# ============================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Crea un proyecto en https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role (SECRETO, solo servidor)
# Connection string de Postgres → Settings → Database → Connection string (URI).
# Usa el pooler en modo transacción (puerto 6543) para serverless.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-region.pooler.supabase.com:6543/postgres

# --- Anthropic (núcleo de IA) ----------------------------------------------
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- YouTube Data API v3 ---------------------------------------------------
# https://console.cloud.google.com → habilita "YouTube Data API v3" → crea API Key
YOUTUBE_API_KEY=AIza...

# --- Voyage AI (embeddings — solo fase RAG, opcional por ahora) -------------
# https://dash.voyageai.com  (200M tokens gratis)
VOYAGE_API_KEY=

# --- Trigger.dev (jobs de generación — opcional en dev) --------------------
# https://cloud.trigger.dev  → Project settings
# Sin estas keys, la generación corre inline en `next dev` (sin timeout).
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Flow.cl (pagos Chile — fase de monetización) --------------------------
# https://www.flow.cl → Integración → API Keys
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# --- Email (Resend) — correos por avance (Fase 2 de engagement) ---
# API key de https://resend.com (permiso de envío, dominio mail.aulia.ai)
RESEND_API_KEY=
# Remitente verificado (subdominio dedicado para proteger la reputación)
EMAIL_FROM="Aulia <hola@mail.aulia.ai>"

# --- Google Gemini — digest de videos de YouTube (coherencia ToS-safe) ---
# https://aistudio.google.com → API key. Procesa URLs de YouTube (video understanding).
GEMINI_API_KEY=

# --- Embudo de negocio ---
# "true" = pago obligatorio ANTES de generar la ruta (requiere Flow productivo)
PAYWALL_ENABLED=false
# Precio por ruta en CLP
PRICE_ROUTE_CLP=9990
# Modo de cobro de Pro: "true" = suscripción con cobro automático (requiere
# PAT activo en Flow) · "false" = Pro manual: cobro único de 30 días, la
# renovación se avisa al cliente (sin PAT).
PRO_SUBSCRIPTION_ENABLED=false
# Correos con acceso al dashboard /app/admin (coma-separados)
ADMIN_EMAILS=

# --- Mercado Pago (Checkout Pro) — si está presente, es el proveedor de pago ---
MP_ACCESS_TOKEN=

# --- Correos de ciclo de vida (renovación Pro D-3/D0 + carros T+1h/T+24h) ---
# Los crons corren siempre; "false" = no encolan (el fundador aprueba copys
# y enciende sin deploy).
LIFECYCLE_EMAILS_ENABLED=false

# --- Ops y observabilidad ---
# Kill-switch global de generación IA (costo diario fuera de umbral)
AI_DISABLED=false
# Secret del cron HTTP de reconciliación (vercel.json → /api/admin/reconcile)
CRON_SECRET=
# WhatsApp del fundador vía CallMeBot (solo incidentes 'critical')
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Cuota YouTube Data API: presupuesto diario y umbral del circuit-breaker
YOUTUBE_QUOTA_DAILY_LIMIT=10000
YOUTUBE_QUOTA_SOFT_LIMIT=8500

# --- ElevenLabs (profesor IA) ---
# HMAC del conversation-initiation webhook (/api/live/initiation)
ELEVENLABS_WEBHOOK_SECRET=

# --- Meta (medición de campañas de ventas) ---
# ID del píxel (Meta Events Manager). Vacío = píxel apagado (no se inyecta nada).
NEXT_PUBLIC_META_PIXEL_ID=
# Token de la Conversions API (fase 2): Purchase server-side deduplicado con el
# del navegador (mismo event_id). Vacío = apagado, solo mide el píxel.
META_CAPI_ACCESS_TOKEN=
